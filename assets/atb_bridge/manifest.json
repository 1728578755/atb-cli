{
  "manifest_version": 3,
  "name": "ATB",
  "version": "5.5.0",
  "description": "Bridge for atb: read pages, click, fill, screenshot, inspect network.",
  "minimum_chrome_version": "120",
  "permissions": [
    "cookies",
    "tabs",
    "tabGroups",
    "activeTab",
    "debugger",
    "scripting",
    "alarms",
    "storage",
    "declarativeNetRequest",
    "webNavigation",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "optional_permissions": [
    "management"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ATB",
    "default_icon": {
      "16": "icons/atb-16.png",
      "32": "icons/atb-32.png",
      "48": "icons/atb-48.png",
      "128": "icons/atb-128.png"
    }
  },
  "icons": {
    "16": "icons/atb-16.png",
    "32": "icons/atb-32.png",
    "48": "icons/atb-48.png",
    "128": "icons/atb-128.png"
  },
  "short_name": "ATB"
}
