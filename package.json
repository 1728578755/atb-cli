{
  "name": "@g1728578755/atb",
  "version": "0.8.0",
  "description": "Agent-oriented browser CLI with multi-tab and multi-agent isolation, backed by a native Rust daemon.",
  "license": "MIT",
  "keywords": [
    "browser",
    "cli",
    "automation",
    "chrome-extension",
    "cdp",
    "rust",
    "ai-agent",
    "multi-tab"
  ],
  "bin": {
    "atb": "npm/bin/atb.js"
  },
  "files": [
    "npm/bin",
    "npm/postinstall.js",
    "scripts/platforms.json",
    "assets",
    "skills",
    "README.md",
    "README_EN.md",
    "AI_INSTALL.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "SOURCES.md",
    "PRIVACY.md"
  ],
  "scripts": {
    "build": "node scripts/check-lock.mjs && cargo build --release --locked",
    "check:lock": "node scripts/check-lock.mjs",
    "test": "node --test",
    "version": "node scripts/sync-version.mjs",
    "sync-version": "node scripts/sync-version.mjs",
    "sync:extension": "node scripts/sync-extension-assets.mjs",
    "check:extension": "node scripts/sync-extension-assets.mjs --check",
    "prepack": "node scripts/sync-version.mjs --deps && node scripts/sync-extension-assets.mjs",
    "postinstall": "node npm/postinstall.js"
  },
  "optionalDependencies": {
    "@g1728578755/atb-darwin-arm64": "0.8.0",
    "@g1728578755/atb-darwin-x64": "0.8.0",
    "@g1728578755/atb-linux-x64": "0.8.0",
    "@g1728578755/atb-linux-arm64": "0.8.0",
    "@g1728578755/atb-win32-x64": "0.8.0"
  },
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://github.com/1728578755/atb-cli",
  "bugs": {
    "url": "https://github.com/1728578755/atb-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1728578755/atb-cli.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
